{
  "name": "@bifrostwallet/assets",
  "version": "0.0.3-beta",
  "description": "Curated assets for Bifrost Wallet.",
  "repository": "https://github.com/bifrostwallet/assets.git",
  "author": "Bifrost Software Ltd",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "yarn": "4.17.1"
  },
  "scripts": {
    "build": "tsc",
    "add:provider": "tsc && ./yarn node build/src/script/providerAdd.js",
    "add:dapp": "tsc && ./yarn node build/src/script/dappAdd.js",
    "remove:provider": "tsc && ./yarn node build/src/script/providerRemove.js",
    "remove:dapp": "tsc && ./yarn node build/src/script/dappRemove.js",
    "sign:provider": "tsc && ./yarn node build/src/script/signProviderInfo.js",
    "verify:providers": "tsc && ./yarn node build/src/script/verifyProviderSignatures.js",
    "verify:provider-domains": "tsc && ./yarn node build/src/script/verifyProviderDomainLinkage.js",
    "sync:domain-linkage": "tsc && ./yarn node build/src/script/syncDomainLinkage.js",
    "sync:management-group": "tsc && ./yarn node build/src/script/syncManagementGroup.js",
    "sync:dual-network": "tsc && ./yarn node build/src/script/syncDualNetwork.js",
    "scan:first-transaction": "tsc && ./yarn node build/src/script/scanFirstTransaction.js",
    "check:providers": "tsc && ./yarn node build/src/script/checkProviders.js",
    "check:tokens": "tsc && ./yarn node build/src/script/checkTokens.js",
    "check:contracts": "tsc && ./yarn node build/src/script/checkContracts.js",
    "check:dapps": "tsc && ./yarn node build/src/script/checkDapps.js",
    "refresh:providers": "tsc && ./yarn node build/src/script/refreshProviders.js",
    "normalize:providers": "tsc && ./yarn node build/src/script/normalizeProviders.js",
    "pull:submissions": "tsc && ./yarn node build/src/script/pullSubmissions.js",
    "verify:no-contact-pii": "./scripts/security/verify-no-contact-pii.sh",
    "manifest:generate-key": "tsc && ./yarn node build/src/script/generateManifestKey.js",
    "build:package": "tsc && ./yarn node build/src/script/packageBuild.js",
    "upload:bucket": "tsc && ./yarn node build/src/script/bucketUpload.js",
    "with:ops-config": "./scripts/with-ops-config.sh",
    "ops:pull-env": "./scripts/pull-ops-env.sh",
    "build:ops-scripts": "tsc -p tsconfig.scripts.json",
    "preinstall": "./scripts/security/require-verified-yarn.sh && ./scripts/security/block-ide-autostart-hooks.sh",
    "prepare": "./scripts/security/require-verified-yarn.sh && ./scripts/security/block-ide-autostart-hooks.sh && ./scripts/install-git-hooks.sh",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:shell": "./scripts/lint-shell.sh",
    "lint:yaml": "./scripts/lint-yaml.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsc && node --test \"build/test/**/*.test.js\"",
    "security:check": "./scripts/security/security-checks.sh",
    "security:verify-node": "./scripts/security/verify-node-version.sh",
    "security:verify-yarn-binary": "./scripts/security/verify-yarn-hash.sh",
    "security:verify-deps": "./scripts/security/verify-yarn-dependencies.sh",
    "security:yarn-binary": "./scripts/security/yarn-binary.sh",
    "security:yarn-binary:upgrade": "./scripts/security/yarn-binary.sh upgrade",
    "security:require-verified-yarn": "./scripts/security/require-verified-yarn.sh",
    "security:block-ide-hooks": "./scripts/security/block-ide-autostart-hooks.sh",
    "security:audit-deps": "./yarn npm audit --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@google-cloud/storage": "7.22.0",
    "@types/node": "22.20.2",
    "bs58": "6.0.0",
    "typescript": "5.9.3",
    "viem": "2.56.5"
  },
  "packageManager": "yarn@4.17.1+sha256.471ffb15e0523663865bbf46a69e7d157ecf532412eb436c48dfab6e3f2abe88"
}
