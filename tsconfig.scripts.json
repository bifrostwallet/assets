{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "outDir": "./build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/ops-config-exports.ts", "scripts/load-ops-env-unset.ts"],
  "exclude": ["node_modules"]
}
